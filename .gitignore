# NOTE: deliberately does NOT ignore bin/ or data/, so the hub's hygiene job
# has committed build artifacts to warn about. That warning is expected.
node_modules/
target/
__pycache__/

# Real .NET build output is ignored. The committed artifacts that hygiene is
# meant to warn about are the deliberate ones in bin/ and data/ at the root.
dotnet/**/bin/
dotnet/**/obj/
